# Competitive Reasoning Arena - environment configuration
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# Server port (default 3000)
PORT=3000

# Path to SQLite database file (dev default: data/arena.db)
DB_PATH=data/arena.db

# Secret used to sign session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Secret mixed into daily challenge seeding. All servers serving the same day must share this value.
DAILY_SEED_SECRET=change-me-too

# Node environment: development | production
NODE_ENV=development

# ── Ads (see docs/ads-integration.md before changing these) ───────────────
# Which ad provider the client loads: mock (default) | google-h5 | off.
# 'google-h5' also requires ADS_CLIENT and a wired server-side verifier.
ADS_PROVIDER=mock

# AdSense / H5 Games Ads publisher id ("ca-pub-XXXXXXXXXXXXXXXX").
# Required only when ADS_PROVIDER=google-h5. Never commit a real value.
ADS_CLIENT=

# Shared secret for validating rewarded-ad completions server-side (e.g. via
# the ad network's SSV callback). Empty = rewards cannot be verified; the
# /api/ad-reward endpoint then only accepts providers with a verifier wired.
ADS_REWARD_SECRET=
